+using Amr.Simulator.Navigation;
+using Xunit;
+
+namespace Amr.Simulator.Tests;
+
+public sealed class GridNavigationTests
+{
+    [Fact]
+    public void OriginalMapHasNineStepPath()
+    {
+        var s = new GridNavigator().Read();
+        Assert.Equal(9, s.RemainingDistance);
+        Assert.Equal(s.Start, s.Path[0]);
+        Assert.Equal(s.Goal, s.Path[^1]);
+        AssertValid(s);
+    }
+
+    [Fact]
+    public void StartEqualsGoalReturnsOneCell()
+    {
+        var cell = new GridCell(0, 0);
+        Assert.Equal(new[] { cell }, GridPathfinder.FindPath(new int[1, 1], cell, cell));
+    }
+
+    [Fact]
+    public void UnreachableReturnsEmptyPath() =>
+        Assert.Empty(GridPathfinder.FindPath(new[,] { { 0, 1, 0 } }, new(0, 0), new(0, 2)));
+
+    [Theory]
+    [InlineData(0, 2)]
+    [InlineData(2, 0)]
+    public void EmptyMapRejected(int rows, int cols) =>
+        Assert.Throws<ArgumentException>(() => GridPathfinder.FindPath(new int[rows, cols], new(0, 0), new(0, 0)));
+
+    [Fact]
+    public void NullMapRejected() =>
+        Assert.Throws<ArgumentNullException>(() => GridPathfinder.FindPath(null!, new(0, 0), new(0, 0)));
+
+    [Theory]
+    [InlineData(-1)]
+    [InlineData(2)]
+    public void NonBinaryMapRejected(int value) =>
+        Assert.Throws<ArgumentException>(() => GridPathfinder.FindPath(new[,] { { 0, value, 0 } }, new(0, 0), new(0, 2)));
+
+    [Theory]
+    [InlineData(-1, 0)]
+    [InlineData(0, -1)]
+    [InlineData(2, 0)]
+    [InlineData(0, 2)]
+    public void InvalidCoordinateRejected(int row, int col) =>
+        Assert.Throws<ArgumentException>(() => GridPathfinder.FindPath(new int[2, 2], new(row, col), new(0, 0)));
+
+    [Theory]
+    [InlineData(1, 0)]
+    [InlineData(0, 1)]
+    public void BlockedEndpointsRejected(int start, int goal) =>
+        Assert.Throws<ArgumentException>(() => GridPathfinder.FindPath(new[,] { { start, goal } }, new(0, 0), new(0, 1)));
+
+    [Fact]
+    public void CompletesInNineStepsAndThenStaysStopped()
+    {
+        var navigator = new GridNavigator();
+        Assert.True(navigator.Start());
+        Assert.False(navigator.Start());
+        for (int i = 0; i < 9; i++) { Assert.True(navigator.Step()); AssertValid(navigator.Read()); }
+        var s = navigator.Read();
+        Assert.Equal("Completed", s.Phase);
+        Assert.Equal(s.Goal, s.Current);
+        Assert.Equal(9, s.Moves);
+        Assert.Equal(0, s.RemainingDistance);
+        Assert.False(navigator.Step());
+        Assert.Equal(s.Current, navigator.Read().Current);
+    }
+
+    [Fact]
+    public void NewObstacleDetoursFromCurrentPosition()
+    {
+        var navigator = new GridNavigator();
+        navigator.Start();
+        for (int i = 0; i < 3; i++) navigator.Step();
+        Assert.Equal(new GridCell(2, 1), navigator.Read().Current);
+        navigator.SetObstacle(new(2, 2), true);
+        var s = navigator.Read();
+        Assert.Equal(new GridCell(2, 1), s.Current);
+        Assert.Equal(8, s.RemainingDistance);
+        Assert.DoesNotContain(new GridCell(2, 2), s.Path);
+        Assert.Equal(new GridCell(2, 0), s.Path[1]);
+        for (int i = 0; i < 8; i++) { Assert.True(navigator.Step()); AssertValid(navigator.Read()); }
+        Assert.Equal("Completed", navigator.Read().Phase);
+        Assert.Equal(11, navigator.Read().Moves);
+    }
+
+    [Fact]
+    public void FullyBlockedWaitsThenAutomaticallyResumes()
+    {
+        var navigator = new GridNavigator();
+        navigator.Start(); navigator.Step();
+        var current = navigator.Read().Current;
+        navigator.SetObstacle(new(1, 1), true);
+        Assert.Equal("Waiting", navigator.Read().Phase);
+        Assert.Null(navigator.Read().RemainingDistance);
+        for (int i = 0; i < 10; i++) Assert.False(navigator.Step());
+        Assert.Equal(current, navigator.Read().Current);
+        Assert.Equal(1, navigator.Read().Moves);
+        navigator.SetObstacle(new(1, 1), false);
+        Assert.Equal("Running", navigator.Read().Phase);
+        Assert.True(navigator.Step());
+        Assert.Equal(new GridCell(1, 1), navigator.Read().Current);
+    }
+
+    [Fact]
+    public void RemovingObstacleSelectsShorterRouteImmediately()
+    {
+        var navigator = new GridNavigator();
+        navigator.SetObstacle(new(2, 2), true);
+        navigator.Start();
+        for (int i = 0; i < 3; i++) navigator.Step();
+        Assert.Equal(8, navigator.Read().RemainingDistance);
+        navigator.SetObstacle(new(2, 2), false);
+        Assert.Equal(6, navigator.Read().RemainingDistance);
+        Assert.Equal(new GridCell(2, 2), navigator.Read().Path[1]);
+    }
+
+    [Fact]
+    public void CancellationStopsMovementAndDoesNotResumeOnMapEdit()
+    {
+        var navigator = new GridNavigator();
+        navigator.Start(); navigator.Step(); navigator.Cancel();
+        var before = navigator.Read();
+        navigator.SetObstacle(new(2, 2), true);
+        Assert.False(navigator.Step());
+        Assert.Equal("Canceled", navigator.Read().Phase);
+        Assert.Equal(before.Current, navigator.Read().Current);
+        Assert.True(navigator.Start());
+        Assert.Equal(before.Start, navigator.Read().Current);
+    }
+
+    [Fact]
+    public void ResetRestoresOriginalMapAndStopsActiveRun()
+    {
+        var navigator = new GridNavigator();
+        navigator.Start(); navigator.Step(); navigator.SetObstacle(new(2, 2), true);
+        navigator.Reset();
+        var s = navigator.Read();
+        Assert.Equal("Ready", s.Phase);
+        Assert.Equal(s.Start, s.Current);
+        Assert.Equal(0, s.Map[2][2]);
+        Assert.Equal(9, s.RemainingDistance);
+        Assert.Equal(0, s.Moves);
+        Assert.False(navigator.Step());
+    }
+
+    [Theory]
+    [InlineData(0, 2)]
+    [InlineData(0, 0)]
+    [InlineData(4, 5)]
+    [InlineData(-1, 0)]
+    [InlineData(5, 0)]
+    public void ProtectedOrInvalidCellEditRejected(int row, int col)
+    {
+        var navigator = new GridNavigator();
+        Assert.Throws<ArgumentException>(() => navigator.SetObstacle(new(row, col), true));
+        Assert.Equal(9, navigator.Read().RemainingDistance);
+        Assert.Equal(0, navigator.Read().MapVersion);
+    }
+
+    [Fact]
+    public void OccupiedCellEditRejectedAndSnapshotIsIndependent()
+    {
+        var navigator = new GridNavigator();
+        navigator.Start(); navigator.Step();
+        var s = navigator.Read();
+        Assert.Throws<ArgumentException>(() => navigator.SetObstacle(s.Current, true));
+        s.Map[0][1] = 1; s.Path[0] = new(99, 99); s.Traveled[0] = new(99, 99);
+        Assert.Equal(0, navigator.Read().Map[0][1]);
+        Assert.Equal(navigator.Read().Current, navigator.Read().Path[0]);
+        Assert.Equal(navigator.Read().Start, navigator.Read().Traveled[0]);
+    }
+
+    [Fact]
+    public void DijkstraMatchesBfsOnThreeHundredSeededMaps()
+    {
+        var random = new Random(221026);
+        for (int trial = 0; trial < 300; trial++)
+        {
+            var map = new int[6, 7];
+            for (int r = 0; r < 6; r++)
+                for (int c = 0; c < 7; c++) map[r, c] = random.Next(100) < 35 ? 1 : 0;
+            var start = new GridCell(random.Next(6), random.Next(7));
+            var goal = new GridCell(random.Next(6), random.Next(7));
+            map[start.Row, start.Col] = map[goal.Row, goal.Col] = 0;
+            var path = GridPathfinder.FindPath(map, start, goal);
+            Assert.Equal(BfsDistance(map, start, goal), path.Count == 0 ? (int?)null : path.Count - 1);
+            for (int i = 0; i < path.Count; i++)
+            {
+                Assert.Equal(0, map[path[i].Row, path[i].Col]);
+                if (i > 0) Assert.Equal(1, Math.Abs(path[i].Row - path[i - 1].Row) + Math.Abs(path[i].Col - path[i - 1].Col));
+            }
+        }
+    }
+
+    private static int? BfsDistance(int[,] map, GridCell start, GridCell goal)
+    {
+        var queue = new Queue<(GridCell Cell, int Distance)>();
+        var visited = new HashSet<GridCell> { start };
+        queue.Enqueue((start, 0));
+        while (queue.TryDequeue(out var item))
+        {
+            if (item.Cell == goal) return item.Distance;
+            foreach (var d in new[] { new GridCell(-1, 0), new(1, 0), new(0, -1), new(0, 1) })
+            {
+                var next = new GridCell(item.Cell.Row + d.Row, item.Cell.Col + d.Col);
+                if (next.Row < 0 || next.Row >= map.GetLength(0) || next.Col < 0 || next.Col >= map.GetLength(1) || map[next.Row, next.Col] == 1 || !visited.Add(next)) continue;
+                queue.Enqueue((next, item.Distance + 1));
+            }
+        }
+        return null;
+    }
+
+    private static void AssertValid(GridSnapshot s)
+    {
+        Assert.Equal(0, s.Map[s.Current.Row][s.Current.Col]);
+        for (int i = 0; i < s.Path.Length; i++)
+        {
+            Assert.Equal(0, s.Map[s.Path[i].Row][s.Path[i].Col]);
+            if (i > 0) Assert.Equal(1, Math.Abs(s.Path[i].Row - s.Path[i - 1].Row) + Math.Abs(s.Path[i].Col - s.Path[i - 1].Col));
+        }
+    }
+}
diff --git a/tests/Amr.Simulator.Tests/GridSimulationTests.cs b/tests/Amr.Simulator.Tests/GridSimulationTests.cs
new file mode 100644
index 0000000..dfb7dc4
--- /dev/null
+++ b/tests/Amr.Simulator.Tests/GridSimulationTests.cs
@@ -0,0 +1,175 @@
+using System.Collections.Concurrent;
+using System.Text.Json;
+using Amr.Communication.Mqtt;
+using Amr.Simulator.Navigation;
+using Amr.Simulator.Telemetry;
+using Xunit;
+
+namespace Amr.Simulator.Tests;
+
+public sealed class GridSimulationTests
+{
+    private static SimulatorMqttOptions Options => new(new MqttConnectionSettings(), 10, 20);
+
+    [Fact]
+    public async Task SimulatorAloneDetoursDuringMovementAndPublishesOrderedMission()
+    {
+        var sender = new Sender();
+        var simulation = Mission(sender);
+        simulation.Moved += () =>
+        {
+            if (simulation.Read().Moves == 1) simulation.SetObstacle(new(2, 2), true);
+        };
+        Assert.True(simulation.Start());
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+        var final = await simulation.RunAsync(Options, timeout.Token);
+        var state = simulation.Read();
+        Assert.Equal("Completed", state.Phase);
+        Assert.Equal(15, state.Moves);
+        Assert.Equal(new[] { 11, 13, 15 }, state.ReachedWaypoints.Select(v => v.Moves));
+        Assert.All(state.Traveled, cell => Assert.Equal(0, state.Map[cell.Row][cell.Col]));
+        Assert.Equal(0, state.ReachedWaypoints[0].Index);
+        Assert.Contains(new GridCell(4, 3), state.Traveled.Take(11));
+        Assert.True(sender.Disposed);
+        var points = sender.Publications.Where(p => p.Kind == "Telemetry").Select(p => JsonSerializer.Deserialize<JsonElement>(p.Payload)).ToArray();
+        Assert.NotEmpty(points);
+        Assert.All(points, p => Assert.Equal("AMR_001", p.GetProperty("id").GetString()));
+        var last = points[^1];
+        Assert.Equal(final!.Timestamp, last.GetProperty("ts").GetInt64());
+        Assert.Equal(5, final.X); Assert.Equal(-4, final.Y);
+        Assert.Equal(0, last.GetProperty("sp").GetDouble());
+        Assert.Equal("IDLE", last.GetProperty("state").GetString());
+    }
+
+    [Fact]
+    public async Task BlockedWaypointWaitsAndResumesWithoutSkippingIt()
+    {
+        var sender = new Sender();
+        var simulation = Mission(sender);
+        simulation.SetObstacle(new(4, 3), true);
+        simulation.Start();
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+        var run = simulation.RunAsync(Options, timeout.Token);
+        await Wait(() => simulation.Read().Phase == "Waiting" && simulation.Read().NextWaypointIndex == 1);
+        var waiting = simulation.Read();
+        int heartbeats = sender.Publications.Count(p => p.Kind == "Heartbeat");
+        await Wait(() => sender.Publications.Count(p => p.Kind == "Heartbeat") >= heartbeats + 2);
+        Assert.Equal(waiting.Current, simulation.Read().Current);
+        simulation.SetObstacle(new(4, 3), false);
+        await run;
+        Assert.Equal(new[] { 0, 1, 2 }, simulation.Read().ReachedWaypoints.Select(v => v.Index));
+    }
+
+    [Theory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public async Task SenderLossStopsAndDisposesSender(bool duringConnect)
+    {
+        var sender = new Sender { LoseOnConnect = duringConnect };
+        var simulation = Mission(sender);
+        simulation.Start();
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+        var run = simulation.RunAsync(Options, timeout.Token);
+        if (!duringConnect)
+        {
+            await Wait(() => sender.Publications.Count > 1);
+            sender.Lose();
+        }
+        var error = await Assert.ThrowsAsync<IOException>(async () => await run);
+        Assert.Equal("SenderDisconnected", error.Message);
+        Assert.Equal("Canceled", simulation.Read().Phase);
+        if (duringConnect) Assert.Equal(0, simulation.Read().Moves);
+        Assert.True(sender.Disposed);
+    }
+
+    [Fact]
+    public async Task CancellationWaitsForSenderCleanupBeforeResetOrRestart()
+    {
+        var sender = new Sender { HoldDisconnect = true };
+        var simulation = Mission(sender);
+        using var cancel = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+        simulation.Start();
+        var run = simulation.RunAsync(Options, cancel.Token);
+        try
+        {
+            await Wait(() => sender.Publications.Count > 1);
+            cancel.Cancel();
+            await Wait(() => sender.Disconnecting);
+            Assert.False(run.IsCompleted);
+            Assert.False(simulation.Start());
+            Assert.Throws<InvalidOperationException>(simulation.Reset);
+        }
+        finally { sender.ReleaseDisconnect(); }
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(async () => await run);
+        Assert.True(sender.Disposed);
+        simulation.Reset();
+        Assert.Equal("Ready", simulation.Read().Phase);
+        Assert.True(simulation.Start());
+    }
+
+    [Fact]
+    public async Task PublishFailureStopsMovementAndCleansUp()
+    {
+        var sender = new Sender { PublishFailure = true };
+        var simulation = Mission(sender);
+        simulation.Start();
+        await Assert.ThrowsAsync<IOException>(() => simulation.RunAsync(Options, CancellationToken.None));
+        Assert.Equal(0, simulation.Read().Moves);
+        Assert.Equal("Canceled", simulation.Read().Phase);
+        Assert.True(sender.Disposed);
+    }
+
+    [Fact]
+    public async Task LocalRunNeedsNoMapOrMqttAndCanRestart()
+    {
+        var simulation = new GridSimulation("local", new(new(0, 0), [new(0, 1), new(0, 2)], new int[1, 3]), 10);
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+        for (int run = 0; run < 2; run++)
+        {
+            Assert.True(simulation.Start());
+            Assert.Null(await simulation.RunAsync(null, timeout.Token));
+            Assert.Equal("Completed", simulation.Read().Phase);
+            Assert.Equal(2, simulation.Read().Moves);
+        }
+    }
+
+    private static GridSimulation Mission(Sender sender) => new("AMR_001",
+        new(new(0, 0), [new(2, 3), new(4, 3), new(4, 5)]), 20, () => sender);
+
+    private static async Task Wait(Func<bool> condition)
+    {
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(4));
+        while (!condition()) await Task.Delay(5, timeout.Token);
+    }
+
+    private sealed class Sender : ISimulationTransport
+    {
+        public event Action? ConnectionLost;
+        public ConcurrentQueue<SimulationPublication> Publications { get; } = new();
+        public bool LoseOnConnect { get; init; }
+        public bool HoldDisconnect { get; init; }
+        public bool PublishFailure { get; init; }
+        public volatile bool Disconnecting, Disposed;
+        private readonly TaskCompletionSource _disconnect = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public Task ConnectAsync(CancellationToken token)
+        {
+            if (LoseOnConnect) Lose();
+            return Task.CompletedTask;
+        }
+        public Task PublishAsync(SimulationPublication publication, CancellationToken token)
+        {
+            token.ThrowIfCancellationRequested();
+            if (PublishFailure) throw new IOException("PublishFailure");
+            Publications.Enqueue(publication);
+            return Task.CompletedTask;
+        }
+        public void Lose() => ConnectionLost?.Invoke();
+        public void ReleaseDisconnect() => _disconnect.TrySetResult();
+        public async Task DisconnectAsync()
+        {
+            Disconnecting = true;
+            if (HoldDisconnect) await _disconnect.Task;
+        }
+        public void Dispose() => Disposed = true;
+    }
+}
diff --git a/tests/Amr.Simulator.Tests/WaypointMissionTests.cs b/tests/Amr.Simulator.Tests/WaypointMissionTests.cs
new file mode 100644
index 0000000..a00a725
--- /dev/null
+++ b/tests/Amr.Simulator.Tests/WaypointMissionTests.cs
@@ -0,0 +1,143 @@
+using Amr.Simulator.Navigation;
+using System.Text;
+using Xunit;
+
+namespace Amr.Simulator.Tests;
+
+public sealed class WaypointMissionTests
+{
+    private static readonly GridCell[] Route = [new(2, 3), new(4, 3), new(4, 5)];
+    private static GridNavigator Mission() => new(new(0, 0), Route);
+
+    [Fact]
+    public void NormalMissionVisitsEveryTargetInOrderAndStopsAtFinalGoal()
+    {
+        var navigator = Mission();
+        Assert.Equal(5, navigator.Read().RemainingDistance);
+        Assert.Equal(Route[0], navigator.Read().CurrentTarget);
+        navigator.Start();
+        for (int move = 1; move <= 9; move++)
+        {
+            Assert.True(navigator.Step());
+            Assert.Equal(move < 9 ? "Running" : "Completed", navigator.Read().Phase);
+        }
+        var state = navigator.Read();
+        Assert.Equal(new[] { 0, 1, 2 }, state.ReachedWaypoints.Select(x => x.Index));
+        Assert.Equal(new[] { 5, 7, 9 }, state.ReachedWaypoints.Select(x => x.Moves));
+        Assert.Equal(Route, state.ReachedWaypoints.Select(x => x.Cell));
+        Assert.Equal(3, state.NextWaypointIndex);
+        Assert.Null(state.CurrentTarget);
+        Assert.False(navigator.Step());
+    }
+
+    [Fact]
+    public void DetourCrossingLaterWaypointDoesNotSkipCurrentTarget()
+    {
+        var navigator = Mission();
+        navigator.Start();
+        for (int i = 0; i < 3; i++) navigator.Step();
+        navigator.SetObstacle(new(2, 2), true);
+        Assert.Equal(8, navigator.Read().RemainingDistance);
+        for (int i = 0; i < 6; i++) navigator.Step();
+        var crossed = navigator.Read();
+        Assert.Equal(Route[1], crossed.Current); // W2를 먼저 지나지만 아직 W1이 목표다.
+        Assert.Equal(0, crossed.NextWaypointIndex);
+        Assert.Empty(crossed.ReachedWaypoints);
+        Assert.Equal(Route[0], crossed.CurrentTarget);
+        for (int i = 0; i < 6; i++) navigator.Step();
+        var completed = navigator.Read();
+        Assert.Equal("Completed", completed.Phase);
+        Assert.Equal(15, completed.Moves);
+        Assert.Equal(new[] { 11, 13, 15 }, completed.ReachedWaypoints.Select(x => x.Moves));
+        Assert.DoesNotContain(new GridCell(2, 2), completed.Traveled);
+    }
+
+    [Fact]
+    public void BlockedCurrentWaypointWaitsAndResumesWithoutSkipping()
+    {
+        var navigator = Mission();
+        navigator.SetObstacle(Route[0], true);
+        navigator.Start();
+        for (int i = 0; i < 5; i++) Assert.False(navigator.Step());
+        Assert.Equal("Waiting", navigator.Read().Phase);
+        Assert.Equal(0, navigator.Read().Moves);
+        Assert.Equal(0, navigator.Read().NextWaypointIndex);
+        navigator.SetObstacle(Route[0], false);
+        for (int i = 0; i < 9; i++) navigator.Step();
+        Assert.Equal("Completed", navigator.Read().Phase);
+    }
+
+    [Fact]
+    public void BlockedFutureWaypointDoesNotPreventReachingCurrentWaypoint()
+    {
+        var navigator = Mission();
+        navigator.SetObstacle(Route[1], true);
+        navigator.Start();
+        Assert.Equal("Running", navigator.Read().Phase);
+        for (int i = 0; i < 5; i++) Assert.True(navigator.Step());
+        Assert.Equal("Waiting", navigator.Read().Phase);
+        Assert.Equal(Route[0], navigator.Read().Current);
+        Assert.Equal(Route[1], navigator.Read().CurrentTarget);
+        Assert.Equal(1, navigator.Read().NextWaypointIndex);
+        for (int i = 0; i < 5; i++) Assert.False(navigator.Step());
+        navigator.SetObstacle(Route[1], false);
+        for (int i = 0; i < 4; i++) navigator.Step();
+        Assert.Equal("Completed", navigator.Read().Phase);
+    }
+
+    [Fact]
+    public void ConsecutiveDuplicateWaypointsConsumeNoExtraMoves()
+    {
+        var navigator = new GridNavigator(new(0, 0), [new(0, 0), new(0, 1), new(0, 1), new(4, 5)]);
+        navigator.Start();
+        for (int i = 0; i < 9; i++) navigator.Step();
+        Assert.Equal("Completed", navigator.Read().Phase);
+        Assert.Equal(new[] { 0, 1, 1, 9 }, navigator.Read().ReachedWaypoints.Select(x => x.Moves));
+    }
+
+    [Fact]
+    public void AllWaypointsAtStartCompleteWithoutMovement()
+    {
+        var navigator = new GridNavigator(new(0, 0), [new(0, 0), new(0, 0)]);
+        Assert.True(navigator.Start());
+        Assert.Equal("Completed", navigator.Read().Phase);
+        Assert.Equal(0, navigator.Read().Moves);
+        Assert.False(navigator.Step());
+    }
+
+    [Fact]
+    public void ResetRestoresOrderedProgressAndDoesNotReuseVisits()
+    {
+        var navigator = Mission();
+        navigator.Start();
+        for (int i = 0; i < 6; i++) navigator.Step();
+        navigator.Reset();
+        var state = navigator.Read();
+        Assert.Equal("Ready", state.Phase);
+        Assert.Equal(0, state.NextWaypointIndex);
+        Assert.Empty(state.ReachedWaypoints);
+        Assert.Equal(Route[0], state.CurrentTarget);
+        Assert.False(navigator.Step());
+    }
+
+    [Fact]
+    public void RouteAndSnapshotsCannotMutateMission()
+    {
+        var source = Route.ToArray();
+        var navigator = new GridNavigator(new(0, 0), source);
+        source[0] = new(99, 99);
+        navigator.Read().Waypoints[0] = new(99, 99);
+        Assert.Equal(Route[0], navigator.Read().CurrentTarget);
+    }
+
+    [Theory]
+    [InlineData(-1, 0)]
+    [InlineData(5, 0)]
+    [InlineData(0, 2)]
+    public void InvalidWaypointRejected(int row, int col) =>
+        Assert.Throws<ArgumentException>(() => new GridNavigator(new(0, 0), [new(row, col)]));
+
+    [Fact]
+    public void EmptyMissionRejected() => Assert.Throws<ArgumentException>(() => new GridNavigator(new(0, 0), []));
+
+}
