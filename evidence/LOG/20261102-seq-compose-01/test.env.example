# Copy to .env in the repository root. .env is ignored by Git.
# Used by: docker compose --env-file .env -f docker/compose.yaml ...
SEQ_HTTP_PORT=59574

# The host .NET application does not load .env automatically.
# Export these values in its terminal; see docker/README.md.
# If SEQ_HTTP_PORT changes, update AMR_SEQ_URL to the same port.
AMR_SEQ_URL=http://127.0.0.1:59574
AMR_SEQ_API_KEY=

# Optional: omit to generate a new RunId for each console process.
# Allowed characters: A-Z, a-z, 0-9, hyphen, underscore; length 1-128.
# AMR_LOG_RUN_ID=manual-seq-demo-01

